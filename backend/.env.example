# CrisisLens Environment Configuration
# API keys are stored only on the backend and NEVER exposed to frontend code.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Meta Model API Integration (Meta Muse Spark / Llama)
# The system connects to the official Meta Model API when credentials are provided.
# When omitted, the platform runs in explicit, transparent Demonstration Mode.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=meta-muse-spark-preview

# Storage & Safety Settings
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB maximum
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_DIR=./uploads
DATABASE_URL=sqlite:///./crisislens.db
